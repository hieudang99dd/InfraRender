{
    servers {
        max_header_size 64KB
        timeouts {
            read_header 10s
            read_body 2m
            write 10m
            idle 2m
        }
    }
}

{$INFRARENDER_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 22MiB
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    log {
        output stdout
        format json
    }

    # Backend routes: API, uploaded images, and render outputs go directly to FastAPI.
    # /api/health and /api/render-status are deliberately public. All other /api/*
    # paths are protected by the backend's own Basic auth middleware (Caddy never
    # terminates that authentication). /uploads/* and /outputs/* are PUBLIC
    # capability URLs — anyone who knows the unguessable UUID filename can read them;
    # that is the documented media contract, not private per-account storage.
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /uploads/* {
        reverse_proxy backend:8000
    }

    handle /outputs/* {
        reverse_proxy backend:8000
    }

    # Everything else is the static frontend (Next.js export served by nginx).
    handle {
        reverse_proxy frontend:3000
    }
}
