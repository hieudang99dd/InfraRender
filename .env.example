# ════════════════════════════════════════════════════════════════════════════════
# InfraRender self-hosted (Docker/Caddy) deployment settings
# ════════════════════════════════════════════════════════════════════════════════
# Copy to ./.env on the production host and fill in the required values.
# Never commit .env or files under ./secrets/.

# ── Local Docker settings ───────────────────────────────────────────────────────
FRONTEND_PORT=3000

# Optional local development key. Production uses ./secrets/openai_api_key.txt instead.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Production domain, without https:// ─────────────────────────────────────────
# Used by Caddy (TLS + routing) and by the backend's CORS/public URL settings.
INFRARENDER_DOMAIN=render.example.com

# ── Retention (days) for unreferenced media ─────────────────────────────────────
# Canonical, read by the backend whose lifecycle runs the retention sweep every
# 24 hours. Accepted range: 1 to 3650.
INFRARENDER_RETENTION_DAYS=30

# ── Container resource limits ───────────────────────────────────────────────────
# Tune these for the VPS before deployment.
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.5
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=1.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.50

# ── Registry deployment ─────────────────────────────────────────────────────────
# compose.deploy.yaml pulls prebuilt images from GHCR.
GHCR_OWNER=hieudang99dd
# Production deploys must set this to a full 40-character Git SHA.
# INFRARENDER_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567

# ── Operations ──────────────────────────────────────────────────────────────────
# Disk warning threshold for ops/production-check.sh.
INFRARENDER_DISK_WARN_PERCENT=85
# Prune backups older than this many days (ops/backup.sh).
INFRARENDER_BACKUP_RETENTION_DAYS=14
