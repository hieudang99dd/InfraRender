# Local Docker settings
FRONTEND_PORT=3000

# Optional local development key. Production uses ./secrets/openai_api_key.txt instead.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Production domain, without https://
INFRARENDER_DOMAIN=render.example.com

# Production access gate. Generate the password hash with Caddy; never store the
# plaintext password in Git.
INFRARENDER_BASIC_AUTH_USER=admin
INFRARENDER_BASIC_AUTH_HASH=

# Production retention. Set either retention value to 0 to disable deletion for that class.
INFRARENDER_UPLOAD_RETENTION_HOURS=168
INFRARENDER_OUTPUT_RETENTION_HOURS=720
INFRARENDER_CLEANUP_INTERVAL_SECONDS=21600
INFRARENDER_LOG_LEVEL=INFO

# Container resource limits. Tune these for the VPS before deployment.
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.5
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=1.0
MAINTENANCE_MEMORY_LIMIT=256m
MAINTENANCE_CPU_LIMIT=0.25
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.50

# Registry deployment.
GHCR_OWNER=hieudang99dd
INFRARENDER_IMAGE_TAG=latest

# Operations.
INFRARENDER_DISK_WARN_PERCENT=85
INFRARENDER_BACKUP_RETENTION_DAYS=14
