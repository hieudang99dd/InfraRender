# Browser-visible backend URL. The static frontend calls FastAPI directly.
# Local development: copy this file to .env.local.
NEXT_PUBLIC_INFRARENDER_API_URL=http://127.0.0.1:8000

# Set true only when building the GitHub Pages site under /InfraRender/.
# Pages builds require NEXT_PUBLIC_INFRARENDER_API_URL to be the deployed HTTPS URL.
# GitHub Actions reads that URL from the repository variable with the same name.
INFRARENDER_PAGES=false

# Never put provider API keys or the backend access token in frontend env files.
# Access tokens are supplied by the user in the application at runtime.
