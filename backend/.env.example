# Copy to backend/.env for local development; never commit that file.
# On a production host, use runtime environment variables / secret settings.
# Restart the backend after changing configuration.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_PROMPT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL is a legacy fallback when OPENAI_PROMPT_MODEL is unset.
# Provider must support /images/edits, /models/{model}, and /chat/completions.
OPENAI_BASE_URL=https://api.openai.com/v1

INFRARENDER_ENV=development
# Application access control (FastAPI Basic auth), separate from the provider key.
# The browser sends `Authorization: Basic base64(user:pass)`; the app asks the user
# for these credentials at login. Leave both blank only for local development.
# Production refuses to start unless the password is at least 12 characters.
INFRARENDER_AUTH_USER=hieu.dv
INFRARENDER_AUTH_PASS=
# Optional production mount for the access password (Docker secret). When set,
# INFRARENDER_AUTH_PASS above is ignored. Never add this to frontend env files.
# INFRARENDER_AUTH_PASS_FILE=/run/secrets/infrarender_auth_pass
INFRARENDER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production CORS example: https://hieudang99dd.github.io (no /InfraRender path).
# Required HTTPS URL in production; may include a reverse-proxy prefix.
INFRARENDER_PUBLIC_BASE_URL=

# Omit DATA_DIR to preserve local backend/uploads, backend/outputs and projects.sqlite3.
# Production must use persistent storage; Docker sets INFRARENDER_DATA_DIR=/data.
# Do not set this variable to an empty value.
# INFRARENDER_DATA_DIR=C:/InfraRenderAI/backend
INFRARENDER_RETENTION_DAYS=30
