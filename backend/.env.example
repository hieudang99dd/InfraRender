# Copy to .env and add the server-side key. Never put this key in frontend env files.
# Restart the backend after changing this file or its environment variables.
OPENAI_API_KEY=
# Use an image-editing model enabled for your API account.
OPENAI_IMAGE_MODEL=gpt-image-2
# Model used to analyze the reference image when generating prompts.
OPENAI_VISION_MODEL=gpt-4o-mini
# Alternative providers need /images/edits support; the connection check uses /models/{model}.
OPENAI_BASE_URL=https://api.openai.com/v1

INFRARENDER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional public backend URL, including any reverse-proxy prefix.
INFRARENDER_PUBLIC_BASE_URL=
